{
  "rewrites": [
    {
      "source": "/oauth2/:match*",
      "destination": "https://carbontrack-ud64.onrender.com/oauth2/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://carbontrack-ud64.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
